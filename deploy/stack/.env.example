# Copy to .env on the server (chmod 600). Never commit .env.

# Public address staff use, e.g. crm.brightday.com.au (DNS A record -> 203.57.50.209)
DOMAIN=crm.example.com.au
ACME_EMAIL=it@example.com.au

# Microsoft Entra app registration "Brightly" (step 4.3)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Only these email domains may sign in (comma separated)
ALLOWED_EMAIL_DOMAINS=prosperum.com.au
# 32 random bytes, base64:  openssl rand -base64 32 | tr -- '+/' '-_'
COOKIE_SECRET=

# The Brightly app image once it exists, and the port it listens on
BRIGHTLY_IMAGE=
APP_PORT=3000

# Database
POSTGRES_PASSWORD=
DB_DATA_DIR=/srv/brightly/pgdata

# Backups: age PUBLIC key (the private key stays offline in the password manager),
# and a SAS URL for the Azure "backups" container with Add, Create, Write, List only.
BACKUP_AGE_RECIPIENT=age1...
AZURE_BACKUP_SAS_URL=https://brightlyarchive01.blob.core.windows.net/backups?sv=...
BACKUP_HOUR=2
BACKUP_SPOOL_DIR=/srv/brightly/backup-spool

# Client vault (secure upload links)
# 32 random bytes, base64: openssl rand -base64 32. Without it the vault's files can't be read:
# keep a copy in the password manager (two people), next to the backup key.
VAULT_KEY=
VAULT_DATA_DIR=/srv/brightly/vault
VAULT_BRAND=Brightday
VAULT_MAX_MB=100
VAULT_LINK_DAYS=14
# Optional: only these staff may use the vault (comma separated); empty = anyone who can sign in
VAULT_ADMIN_EMAILS=
# Optional email (Microsoft 365 SMTP AUTH or another provider). Without it nothing is emailed:
# staff copy the link and code themselves. Notices go to VAULT_NOTIFY_TO, else the link's creator.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
VAULT_NOTIFY_TO=

# AI reviewer of vault uploads (optional until set; reviews wait in the queue)
# Claude: either an Anthropic API key (documents processed offshore, mainly the US) ...
ANTHROPIC_API_KEY=
# ... or Amazon Bedrock in Sydney (processed in Australia). Set the first to 1 and the AWS keys
# of an IAM user allowed only bedrock:InvokeModel*; REVIEW_MODEL then takes the Bedrock model ID.
CLAUDE_CODE_USE_BEDROCK=
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REVIEW_MODEL=claude-opus-5-5
# Most a single review may spend (US$). A typical review of a few statements is well under $1.
REVIEW_MAX_USD=3
REVIEW_QUIET_MINUTES=30
# Read-only database login for the reviewer, e.g. postgresql://reviewer:<pw>@db:5432/brightly
REVIEW_DB_URL=
# SharePoint: Entra app with Graph Sites.Selected, granted write on the XPlan Files site only
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE=prosperum.sharepoint.com:/sites/ProsperumTeamFiles
SHAREPOINT_CLIENTS_PATH=General/XPlan Files/Clients
