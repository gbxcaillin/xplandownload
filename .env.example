# Copy this file to .env and fill in the values from the encrypted Iress email.
# .env is git-ignored - never commit real credentials.

# --- Iress MFT (SFTP) account ---
MFT_HOST=mft.iress.com.au
MFT_PORT=22
MFT_USERNAME=
MFT_PASSWORD=
# Optional: only download this file (default: everything on the account)
MFT_REMOTE_FILE=

# --- Password to unzip the extract ---
ZIP_PASSWORD=

# --- SQL Server used to restore the .bak backup ---
# Windows + SQL Server Express with Windows login:  SQL_SERVER=.\SQLEXPRESS  (leave SQL_USER empty)
# Docker (docker compose up -d):                     values below
SQL_SERVER=localhost,1433
SQL_USER=sa
SQL_PASSWORD=Change_Me_Str0ng!
# Only needed when SQL Server can't see this machine's files directly (Docker / remote server)
BACKUP_SHARE_LOCAL=data/sqlbackups
BACKUP_SHARE_SERVER=/var/opt/mssql/backups

OUTPUT_DIR=output
